# Environment variables for the RPi5 production runtime.
# Copy this file to ops/docker/.env and fill in real values.
# NEVER commit the filled .env file — it is git-ignored.

# Postgres password for the quant_risk database user.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-password

# Secret for signing session cookies (32 random bytes, hex-encoded).
# Generate: openssl rand -hex 32
COOKIE_SECRET=change-me-32-byte-hex-secret

# Shared bearer token for POST /api/internal/predictions.
# The off-box inference runner on the workstation uses this token to push
# daily predictions into serving.duckdb. If left empty the endpoint returns
# 503 and no off-box pushes are accepted.
# Generate: openssl rand -hex 32
INTERNAL_TOKEN=
